extends RefCounted
class_name GameEndings

## 结局事件管理（按 结局.txt）
## - 每次结算时判定：心情 / 免疫力 / 物资 任一 <= 0 → 对应坏结局（优先级 免疫力 > 物资 > 心情）
## - 第 14 天结算：三个开关（值守度 = 1 / 儿子完美结局 = 1 / 你是我的好爸爸 = 1）
##   全满足 → 完美结局「在结束的那一天」；否则普通好结局「平庸却坚定」
## - 结局以卡片形式替换当天结算卡；art 预留结局配图（空 = 留白，以后按 IMAGE_LIST 统一导入）

const DAY_FINAL := 14

## 判定当前是否触发结局；未触发返回 {}
static func judge(stats: Dictionary, flags: Dictionary, day: int) -> Dictionary:
	var son := bool(flags.get("son_perfect", false))
	var dad := bool(flags.get("good_dad", false))
	if int(stats["immunity"]) <= 0:
		return {"title": "需要医院", "art": "be3",
			"text": "刚开始儿子病倒了，然后是妻子和女儿。我本来以为自己会是一个无症状感染者，直到我烧到40度。我对不起他们，是我带来的病毒。我们在社区志愿者的帮助下进入了方舱医院，被拆分到不同地方。我要赶紧好起来，然后见他们。"}
	if int(stats["supplies"]) <= 0:
		return {"title": "还好有政府", "art": "be1",
			"text": "勉强度日。我们被当做了困难家庭，获得了街道网格员和其他下沉党员的免费援助。大家顿顿都有吃的了，但也没心思再去想任何事。"}
	if int(stats["mood"]) <= 0:
		if not son:
			return {"title": "离开", "art": "be2_1",
				"text": "他在哪？一个夜里，儿子打开了门，然后再也没回来。没人知道他是怎么做到的，那么多监控和卡口管理人员。妻子每天都在哭。我们想他。"}
		elif not dad:
			return {"title": "离开", "art": "be2_2",
				"text": "她在那？我们以为女儿是最省心的，但是疫情后，她离开了，连句道别都没留。妻子每天都在哭。我们想她。"}
		else:
			return {"title": "离开", "art": "be2_3",
				"text": "我可能不是一个称职的父亲。前妻在女儿高考后跟我离婚，我带走没成年的儿子，而她们一起离开了。儿子还在上高中，我需要支撑下去。"}
	if day >= DAY_FINAL:
		if bool(flags.get("duty", false)) and son and dad:
			return {"title": "在结束的那一天", "art": "",
				"text": "平平安安。当病毒的雾霾散去，你在短暂的喜悦后，更感到的是如释重负。妻子在给所有认识的朋友报平安，孩子们则更忧心即将到来的回堂测试。这个家庭没有被天灾打倒。你其实也没有多少感触，想起沉重的新闻，沉重的话题，沉重的防护服，你其实很惊讶自己扛下来了，湖北扛下来了，中国扛下来了。你对未来一无所知：这个家庭的未来是怎样的？病毒还会回来吗？这道横亘在人类历史上的深重创口，真的还会弥合吗？你不知道。不过，在以后，每当你回想起这段岁月，你也是抗疫一线基层防线一个英勇的标点，你就感到——热泪盈眶。"}
		return {"title": "平庸却坚定", "art": "",
			"text": "这就够了。我们坚持到了封城的结束。疫情见证了我们家庭的努力，谁都没有被打倒。我们对未来充满期望。"}
	return {}
